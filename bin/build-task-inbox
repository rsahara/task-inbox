#!/usr/bin/env python3
"""Build a standalone zipapp containing code only, never tasks or credentials."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import tarfile
import tempfile
import zipapp

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--output", required=True)
parser.add_argument("--format", choices=("zipapp", "source"), default="zipapp")
args = parser.parse_args()
output = Path(args.output).absolute()
if output.exists():
    parser.error("output already exists; choose another path")
with tempfile.TemporaryDirectory(prefix="task-runtime-build-") as temp:
    staging = Path(temp)
    names = ("__init__.py", "store.py", "runtime.py", "lifecycle.py", "cli.py", "transport.py", "leases.py", "maintenance.py", "completion.py", "task_io.py", "layout.py", "git_support.py", "reports.py", "signals.py")
    if args.format == "source":
        selected = ["foundation/task_runtime/" + name for name in names] + [
            "LICENSE", "docs/task-runtime.md", "bin/task-inbox",
            "bin/build-task-inbox", "docs/task-runtime-adapters.md", "test/task_runtime_test.py",
            "test/task_transport_test.py", "test/fixtures/task_transport_adapter.py",
            "docs/task-runtime-leases.md", "test/task_lease_test.py", "test/fixtures/task_lease_adapter.py",
            "docs/task-runtime-timeouts.md", "test/task_timeout_test.py", "test/fixtures/task_timeout_adapter.py",
            "docs/task-runtime-cleanup.md", "test/task_cleanup_test.py", "test/task_metadata_retirement_test.py",
            "docs/task-runtime-completion.md", "test/task_completion_test.py",
            "docs/task-io.md", "test/task_io_test.py", "docs/task-signals.md", "test/task_signals_test.py",
            "docs/task-runtime-scenarios.md", "test/task_scenarios_test.py",
            "test/fixtures/task_scenario_worker.py",
            "test/fixtures/task_legacy_prepare.py",
            "docs/task-runtime-reports.md", "test/task_reports_test.py",
            "docs/task-runtime-slim.md", "test/task_slim_test.py",
            "docs/task-runtime-processes.md", "docs/task-runtime-deployment.md",
            "test/task_layout_test.py", "test/task_cli_test.py", "test/task_store_test.py",
            "test/git_process_test.py", "test/fixtures/git_maintenance_probe.py", ".coveragerc"]
        manifest = {"format": 1, "files": {}}
        for name in selected:
            target = staging / name
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(root / name, target)
            manifest["files"][name] = hashlib.sha256(target.read_bytes()).hexdigest()
        (staging / "README.md").write_text(
            "# Portable Git task runtime\n\n"
            "Git + Python 3.10+, Linux/macOS/WSL. No account or service defaults.\n\n"
            "See [usage and protocol](docs/task-runtime.md). "
            "Run `python3 -W error::ResourceWarning -m unittest discover -s test -p '*test.py'`.\n\n"
            "Licensed under the [MIT License](LICENSE).\n\n"
            "This source tree may be committed and customized in an independent repository. "
            "Task data, remote configuration, credentials and runtime state are excluded.\n")
        (staging / "MANIFEST.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        def portable_metadata(info):
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            info.mtime = 0
            return info
        with tarfile.open(output, "w:gz") as archive:
            for path in sorted(staging.rglob("*")):
                if path.is_file():
                    archive.add(path, arcname="task-runtime/" + str(path.relative_to(staging)),
                                recursive=False, filter=portable_metadata)
        print(output)
        raise SystemExit(0)
    shutil.copyfile(root / "LICENSE", staging / "LICENSE")
    package = staging / "task_runtime"
    package.mkdir()
    # Explicit allowlist excludes task data, private state, bytecode and tools
    # whose defaults reference any personal account or external service.
    for name in names:
        shutil.copyfile(root / "foundation/task_runtime" / name, package / name)
    (staging / "__main__.py").write_text("from task_runtime.cli import main\nraise SystemExit(main())\n")
    zipapp.create_archive(staging, output, interpreter="/usr/bin/env python3", compressed=True)
    output.chmod(0o755)
print(output)
